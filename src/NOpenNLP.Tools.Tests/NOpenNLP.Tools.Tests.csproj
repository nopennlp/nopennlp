<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Tests run on net10.0 by default, so a clone with only the current SDK can
      run them. Set TestFrameworks=true (as CI does) to build every test client.

      Test client to target under test:

        Test client | Library under test
        net10.0     | net10.0
        net9.0      | netstandard2.0
        net8.0      | net8.0
        net462      | netstandard2.0  (Windows only)

      netstandard2.0 has no runtime of its own, so net9.0 is designated as its
      test client (see SetTargetFramework below). Without this the netstandard2.0
      build would ship untested, and it is the leg most likely to break, since it
      lacks the BCL APIs the other targets have.

      net462 tests the same netstandard2.0 build on .NET Framework, which is the
      lowest target Lucene.NET supports and the consumer this port is for. It is
      a second client for netstandard2.0 rather than a replacement for the net9.0
      one: net9.0 catches missing BCL APIs, while net462 catches what only the
      old runtime does differently (assembly binding of the polyfill packages,
      culture and encoding behaviour, no Span intrinsics). .NET Framework only
      runs on Windows, so this leg is conditioned on the host OS; on Linux and
      macOS TestFrameworks=true yields the three cross-platform clients.
    -->
    <TargetFrameworks>net10.0</TargetFrameworks>
    <TargetFrameworks Condition=" '$(TestFrameworks)' == 'true' ">net10.0;net9.0;net8.0</TargetFrameworks>
    <TargetFrameworks Condition=" '$(TestFrameworks)' == 'true' and '$([MSBuild]::IsOSPlatform(Windows))' == 'true' ">$(TargetFrameworks);net462</TargetFrameworks>
    <LangVersion>12.0</LangVersion>
    <RootNamespace>NOpenNLP.Tools</RootNamespace>
    <AssemblyName>NOpenNLP.Tools.Tests</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>

    <!--
      Applies the runsettings without anyone having to pass -s, so a plain
      "dotnet test" is quiet. See the comments in the file itself for what it
      suppresses and why suppressing at the runner rather than at the ported
      call sites is what keeps the next 1.9.x rebase cheap.

      The full output is still one flag away: append the adapter setting
      NUnit.ConsoleOut=1 as a runner argument, after a bare double-dash
      separator on the dotnet test command line. That overrides what this file
      sets, without needing a second runsettings file or a rebuild.

      Pointing the settings switch at an empty or non-XML file is not an escape
      hatch: VSTest rejects it outright ("Root element is missing") rather than
      falling back to defaults.
    -->
    <RunSettingsFilePath>$(MSBuildProjectDirectory)/NOpenNLP.Tools.Tests.runsettings</RunSettingsFilePath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="4.6.1" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>

  <!--
    Points the net9.0 test client at the netstandard2.0 build of the library
    rather than letting NuGet resolution pick net8.0, which is what makes the
    netstandard2.0 target testable at all. net462 would resolve to netstandard2.0
    on its own, being the only compatible target, but it is pinned here too so
    the leg fails loudly rather than silently re-pointing if the library ever
    adds a net4x target.
  -->
  <PropertyGroup Label="Mismatched Target Framework (to override the target framework under test)">
    <SetTargetFramework></SetTargetFramework>
    <SetTargetFramework Condition=" '$(TargetFramework)' == 'net9.0' or '$(TargetFramework)' == 'net462' ">TargetFramework=netstandard2.0</SetTargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NOpenNLP.Tools\NOpenNLP.Tools.csproj"
                      SetTargetFramework="$(SetTargetFramework)" />
  </ItemGroup>

  <!--
    The netstandard2.0 build of the library compiles against the polyfills below,
    but NuGet resolves this project's package assets against net9.0, where those
    APIs are already in the framework, and so contributes no assembly for them.
    The result builds clean and then throws FileNotFoundException on first use at
    run time. Referencing them here puts the implementation assemblies in the
    test output. net462 is listed for the same reason, and additionally needs
    Microsoft.Bcl.Memory to compile at all: DataInputTest indexes from the end
    (testBytes[^1]), and System.Index is not in net462's BCL — the package ships
    a public one in lib/net462. PolySharp is not an alternative here, since its
    polyfills are internal and so invisible from this assembly. Keep this list in
    sync with the netstandard2.0 ItemGroup in NOpenNLP.Tools.csproj.
  -->
  <ItemGroup Condition=" '$(TargetFramework)' == 'net9.0' or '$(TargetFramework)' == 'net462' ">
    <PackageReference Include="Microsoft.Bcl.HashCode" Version="6.0.0" />
    <PackageReference Include="Microsoft.Bcl.Memory" Version="10.0.10" />
  </ItemGroup>

  <!--
    .NET Framework resolves assembly references by exact version at run time, and
    the polyfill packages above drag in several System.* assemblies (Memory,
    Runtime.CompilerServices.Unsafe, Buffers, Numerics.Vectors) at versions that
    differ from what other references were built against. Without redirects the
    tests build clean and then throw FileLoadException on first use, which is the
    classic net4x failure this leg exists to catch — but in the harness rather
    than in the port. AutoGenerateBindingRedirects writes them into the test
    host's .config; GenerateBindingRedirectsOutputType puts them in the file
    vstest actually loads. Both are required: dropping either one is a run-time
    failure a green build will not warn about, so verify the leg still executes
    tests (not merely compiles) before removing them.
  -->
  <PropertyGroup Condition=" '$(TargetFramework)' == 'net462' ">
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
  </PropertyGroup>

  <!--
    Test resources copied from opennlp-tools/src/test/resources upstream. The
    LogicalName mirrors the upstream classpath path so tests can load them the
    same way the library does, via J2N's FindAndGetManifestResourceStream (see
    TestResources). Keep the file location and the LogicalName in sync with
    upstream so future ports are a straight copy.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Doccat\DoccatSample.txt"
                      LogicalName="opennlp.tools.doccat.DoccatSample.txt" />
    <EmbeddedResource Include="Postag\TagDictionaryCaseSensitive.xml"
                      LogicalName="opennlp.tools.postag.TagDictionaryCaseSensitive.xml" />
    <EmbeddedResource Include="Postag\TagDictionaryCaseInsensitive.xml"
                      LogicalName="opennlp.tools.postag.TagDictionaryCaseInsensitive.xml" />
    <EmbeddedResource Include="Postag\TagDictionaryWithoutCaseAttribute.xml"
                      LogicalName="opennlp.tools.postag.TagDictionaryWithoutCaseAttribute.xml" />
    <EmbeddedResource Include="Postag\AnnotatedSentences.txt"
                      LogicalName="opennlp.tools.postag.AnnotatedSentences.txt" />
    <EmbeddedResource Include="Postag\AnnotatedSentencesInsufficient.txt"
                      LogicalName="opennlp.tools.postag.AnnotatedSentencesInsufficient.txt" />
    <EmbeddedResource Include="Lemmatizer\smalldictionary.dict"
                      LogicalName="opennlp.tools.lemmatizer.smalldictionary.dict" />
    <EmbeddedResource Include="Lemmatizer\smalldictionarymulti.dict"
                      LogicalName="opennlp.tools.lemmatizer.smalldictionarymulti.dict" />
    <EmbeddedResource Include="Lemmatizer\output.txt"
                      LogicalName="opennlp.tools.lemmatizer.output.txt" />
    <EmbeddedResource Include="Lemmatizer\trial.old.tsv"
                      LogicalName="opennlp.tools.lemmatizer.trial.old.tsv" />
    <EmbeddedResource Include="Lemmatizer\trial.old-insufficient.tsv"
                      LogicalName="opennlp.tools.lemmatizer.trial.old-insufficient.tsv" />
    <EmbeddedResource Include="Util\Featuregen\*.xml"
                      LogicalName="opennlp.tools.util.featuregen.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Formats\brown-cluster.txt"
                      LogicalName="opennlp.tools.formats.brown-cluster.txt" />
    <EmbeddedResource Include="Chunker\*.bin"
                      LogicalName="opennlp.tools.chunker.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Chunker\test.txt"
                      LogicalName="opennlp.tools.chunker.test.txt" />
    <EmbeddedResource Include="Chunker\test-insufficient.txt"
                      LogicalName="opennlp.tools.chunker.test-insufficient.txt" />
    <EmbeddedResource Include="Chunker\output.txt"
                      LogicalName="opennlp.tools.chunker.output.txt" />
    <EmbeddedResource Include="Tokenize\latin-detokenizer.xml"
                      LogicalName="opennlp.tools.tokenize.latin-detokenizer.xml" />
    <EmbeddedResource Include="Tokenize\token.train"
                      LogicalName="opennlp.tools.tokenize.token.train" />
    <EmbeddedResource Include="Tokenize\token-insufficient.train"
                      LogicalName="opennlp.tools.tokenize.token-insufficient.train" />
    <EmbeddedResource Include="Sentdetect\abb.xml"
                      LogicalName="opennlp.tools.sentdetect.abb.xml" />
    <EmbeddedResource Include="Sentdetect\Sentences.txt"
                      LogicalName="opennlp.tools.sentdetect.Sentences.txt" />
    <EmbeddedResource Include="Sentdetect\SentencesInsufficient.txt"
                      LogicalName="opennlp.tools.sentdetect.SentencesInsufficient.txt" />
    <EmbeddedResource Include="Namefind\AnnotatedSentences.txt"
                      LogicalName="opennlp.tools.namefind.AnnotatedSentences.txt" />
    <EmbeddedResource Include="Namefind\AnnotatedSentencesInsufficient.txt"
                      LogicalName="opennlp.tools.namefind.AnnotatedSentencesInsufficient.txt" />
    <EmbeddedResource Include="Namefind\AnnotatedSentencesWithTypes.txt"
                      LogicalName="opennlp.tools.namefind.AnnotatedSentencesWithTypes.txt" />
    <EmbeddedResource Include="Namefind\html1.train"
                      LogicalName="opennlp.tools.namefind.html1.train" />
    <EmbeddedResource Include="Namefind\OnlyWithEntitiesWithTypes.train"
                      LogicalName="opennlp.tools.namefind.OnlyWithEntitiesWithTypes.train" />
    <EmbeddedResource Include="Namefind\OnlyWithNames.train"
                      LogicalName="opennlp.tools.namefind.OnlyWithNames.train" />
    <EmbeddedResource Include="Namefind\OnlyWithNamesWithTypes.train"
                      LogicalName="opennlp.tools.namefind.OnlyWithNamesWithTypes.train" />
    <EmbeddedResource Include="Namefind\voa1.train"
                      LogicalName="opennlp.tools.namefind.voa1.train" />
    <EmbeddedResource Include="Parser\en_head_rules"
                      LogicalName="opennlp.tools.parser.en_head_rules" />
    <EmbeddedResource Include="Parser\parser.train"
                      LogicalName="opennlp.tools.parser.parser.train" />
    <EmbeddedResource Include="Parser\test.parse"
                      LogicalName="opennlp.tools.parser.test.parse" />
    <!--
      The Prepositional Phrase Attachment corpus, used by the *PrepAttachTest
      trainer tests to check that training actually converges. Upstream also
      ships a "bitstrings" file in this folder, which is 2.2 MB and which no
      test reads, so it is not copied here. See Data/Ppa/NOTICE for attribution.
    -->
    <EmbeddedResource Include="Ml\Maxent\football.dat"
                      LogicalName="opennlp.tools.ml.maxent.football.dat" />
    <EmbeddedResource Include="Data\Opennlp\Maxent\real-valued-weights-training-data.txt"
                      LogicalName="data.opennlp.maxent.real-valued-weights-training-data.txt" />
    <EmbeddedResource Include="Data\Opennlp\Maxent\repeat-weighting-training-data.txt"
                      LogicalName="data.opennlp.maxent.repeat-weighting-training-data.txt" />
    <EmbeddedResource Include="Data\Ppa\training"
                      LogicalName="data.ppa.training" />
    <EmbeddedResource Include="Data\Ppa\devset"
                      LogicalName="data.ppa.devset" />
  </ItemGroup>

</Project>
