.DS_Store

# Integration test data: pre-trained models downloaded from the Apache OpenNLP
# SourceForge site, and the optional Leipzig corpus. Downloaded on demand and
# cached; never committed. See src/NOpenNLP.Tools.Tests/Integration/README.md.
testdata/

# BenchmarkDotNet output.
BenchmarkDotNet.Artifacts/

# Maven build output for the JMH benchmarks under src/java/.
target/

# Models trained on demand by the model compatibility harness, in both
# directions, plus the inference output each runtime records for the other to
# compare against. Never committed; see src/java/model-compat/README.md.
src/java/model-compat/work/

# Scratch space for build/regress.ps1: the corpora copies and captured CLI
# output it diffs. Cleared at the start of each run; never committed.
_artifacts/

# docfx output. `api` holds the metadata docfx generates from the compiled
# assemblies on each run, and `_site` the rendered site; both are derived from
# the source beside them. The package.md files under src/ are the hand-written
# input and are committed.
websites/apidocs/api/
websites/apidocs/_site/

# The structured log build/verify-package-docs.ps1 reads.
docfx.log
